NODE_ENV=development
PORT=3333
LOG_LEVEL=debug

# ── Banco (Supabase) ──────────────────────────────────────────────────────────
# supabase.com → seu projeto → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20"
DIRECT_DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# console.upstash.com → seu banco → Details → REDIS_URL
REDIS_URL="rediss://default:[password]@[host].upstash.io:6379"

# ── Autenticação ──────────────────────────────────────────────────────────────
AUTH_MODE=single-user
SINGLE_USER_EMAIL=dev@clipforge.local
SINGLE_USER_NAME="Dev ClipForge"
ALLOW_SINGLE_USER_IN_PRODUCTION=false

SUPABASE_URL=""
SUPABASE_JWT_ISSUER=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Storage (Cloudflare R2) ───────────────────────────────────────────────────
# dash.cloudflare.com → R2 → seu bucket → Settings
STORAGE_DRIVER=s3
PUBLIC_API_URL="https://sua-api.railway.app/api/v1"
FILE_TOKEN_SECRET=""

STORAGE_ENDPOINT="https://[account-id].r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="clipforge"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL="https://[seu-dominio-publico-r2]"
STORAGE_FORCE_PATH_STYLE=true

# ── Providers de IA ───────────────────────────────────────────────────────────
TRANSCRIPTION_PROVIDER=openai
LLM_PROVIDER=openai

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
DEEPGRAM_API_KEY=""
ASSEMBLYAI_API_KEY=""

# ── Binários externos ─────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp
TMP_DIR=./tmp/clipforge

# ── Workers ───────────────────────────────────────────────────────────────────
WORKER_MEDIA_CONCURRENCY=2
WORKER_AI_CONCURRENCY=8
WORKER_CPU_CONCURRENCY=4
WORKER_RENDER_CONCURRENCY=1
SHUTDOWN_TIMEOUT_MS=30000

# ── Segurança ─────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000,https://seu-frontend.vercel.app"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
MAX_UPLOAD_BYTES=5368709120

# ── Integrações (opcionais) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RESEND_API_KEY=""
YOUTUBE_API_KEY=""
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
